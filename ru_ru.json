package com.cameralock.client.config;

import me.shedaniel.clothconfig2.api.ConfigBuilder;
import me.shedaniel.clothconfig2.api.ConfigCategory;
import net.minecraft.client.KeyMapping;
import net.minecraft.client.gui.screens.Screen;
import net.minecraft.network.chat.Component;

public final class CameraLockConfigScreen {
	private CameraLockConfigScreen() {
	}

	public static Screen build(Screen parent, KeyMapping toggleKey) {
		CameraLockConfig editing = CameraLockConfigManager.get().copy();

		ConfigBuilder builder = ConfigBuilder.create()
			.setParentScreen(parent)
			.setTitle(Component.translatable("title.cameralock.config"))
			.setSavingRunnable(() -> CameraLockConfigManager.replace(editing, toggleKey));

		ConfigCategory general = builder.getOrCreateCategory(Component.translatable("category.cameralock.general"));
		ConfigCategory combat = builder.getOrCreateCategory(Component.translatable("category.cameralock.combat"));
		ConfigCategory weapons = builder.getOrCreateCategory(Component.translatable("category.cameralock.weapons"));
		ConfigCategory targets = builder.getOrCreateCategory(Component.translatable("category.cameralock.targets"));

		general.addEntry(builder.entryBuilder()
			.startIntSlider(Component.translatable("option.cameralock.toggle_key"), CameraLockKeys.indexForCode(editing.toggleKey), 0, CameraLockKeys.NAMES.length - 1)
			.setDefaultValue(1)
			.setTextGetter(i -> Component.literal(CameraLockKeys.NAMES[i]))
			.setSaveConsumer(i -> editing.toggleKey = CameraLockKeys.CODES[i])
			.build());

		general.addEntry(builder.entryBuilder()
			.startDoubleField(Component.translatable("option.cameralock.look_speed"), editing.lookSpeed)
			.setDefaultValue(2.8D)
			.setMin(0.5D).setMax(12.0D)
			.setSaveConsumer(value -> editing.lookSpeed = value)
			.build());

		general.addEntry(builder.entryBuilder()
			.startDoubleField(Component.translatable("option.cameralock.smoothness"), editing.smoothness)
			.setDefaultValue(3.5D)
			.setMin(0.5D).setMax(12.0D)
			.setSaveConsumer(value -> editing.smoothness = value)
			.build());

		general.addEntry(builder.entryBuilder()
			.startDoubleField(Component.translatable("option.cameralock.lock_radius"), editing.lockRadius)
			.setDefaultValue(10.0D)
			.setMin(3.0D).setMax(32.0D)
			.setSaveConsumer(value -> editing.lockRadius = value)
			.build());

		general.addEntry(builder.entryBuilder()
			.startDoubleField(Component.translatable("option.cameralock.lock_fov"), editing.lockFOV)
			.setDefaultValue(90.0D)
			.setMin(10.0D).setMax(360.0D)
			.setSaveConsumer(value -> editing.lockFOV = value)
			.build());

		general.addEntry(builder.entryBuilder()
			.startBooleanToggle(Component.translatable("option.cameralock.show_fov"), editing.showFOV)
			.setDefaultValue(false)
			.setSaveConsumer(value -> editing.showFOV = value)
			.build());

		general.addEntry(builder.entryBuilder()
			.startBooleanToggle(Component.translatable("option.cameralock.check_visibility"), editing.checkVisibility)
			.setDefaultValue(true)
			.setSaveConsumer(value -> editing.checkVisibility = value)
			.build());

		combat.addEntry(builder.entryBuilder()
			.startBooleanToggle(Component.translatable("option.cameralock.auto_attack"), editing.autoAttack)
			.setDefaultValue(false)
			.setSaveConsumer(value -> editing.autoAttack = value)
			.build());

		combat.addEntry(builder.entryBuilder()
			.startBooleanToggle(Component.translatable("option.cameralock.randomize_target"), editing.randomizeTarget)
			.setDefaultValue(false)
			.setSaveConsumer(value -> editing.randomizeTarget = value)
			.build());

		combat.addEntry(builder.entryBuilder()
			.startBooleanToggle(Component.translatable("option.cameralock.auto_crits"), editing.autoCriticals)
			.setDefaultValue(false)
			.setSaveConsumer(value -> editing.autoCriticals = value)
			.build());

		weapons.addEntry(builder.entryBuilder()
			.startBooleanToggle(Component.translatable("option.cameralock.sword_18"), editing.swordMode18)
			.setDefaultValue(false)
			.setSaveConsumer(value -> editing.swordMode18 = value)
			.build());

		weapons.addEntry(builder.entryBuilder()
			.startBooleanToggle(Component.translatable("option.cameralock.mace_logic"), editing.maceLogic)
			.setDefaultValue(true)
			.setSaveConsumer(value -> editing.maceLogic = value)
			.build());

		weapons.addEntry(builder.entryBuilder()
			.startDoubleField(Component.translatable("option.cameralock.mace_min_fall"), editing.maceMinFallDistance)
			.setDefaultValue(0.5D)
			.setMin(0.1D).setMax(5.0D)
			.setSaveConsumer(value -> editing.maceMinFallDistance = value)
			.build());

		targets.addEntry(builder.entryBuilder()
			.startBooleanToggle(Component.translatable("option.cameralock.prioritize_hp"), editing.prioritizeLowHP)
			.setDefaultValue(true)
			.setSaveConsumer(value -> editing.prioritizeLowHP = value)
			.build());

		targets.addEntry(builder.entryBuilder()
			.startBooleanToggle(Component.translatable("option.cameralock.sticky_target"), editing.stickyTarget)
			.setDefaultValue(true)
			.setTooltip(Component.translatable("option.cameralock.sticky_target.tooltip"))
			.setSaveConsumer(value -> editing.stickyTarget = value)
			.build());

		targets.addEntry(builder.entryBuilder()
			.startBooleanToggle(Component.translatable("option.cameralock.target_players"), editing.targetPlayers)
			.setDefaultValue(true)
			.setSaveConsumer(value -> editing.targetPlayers = value)
			.build());

		targets.addEntry(builder.entryBuilder()
			.startBooleanToggle(Component.translatable("option.cameralock.target_mobs"), editing.targetMobs)
			.setDefaultValue(true)
			.setSaveConsumer(value -> editing.targetMobs = value)
			.build());

		return builder.build();
	}
}