package com.cameralock.client.config;

import com.cameralock.client.CameraLockClient;
import com.cameralock.client.CameraLockKeyHandler;
import com.google.gson.Gson;
import com.google.gson.GsonBuilder;
import com.mojang.blaze3d.platform.InputConstants;
import net.fabricmc.loader.api.FabricLoader;
import net.minecraft.client.KeyMapping;
import net.minecraft.client.Minecraft;
import org.lwjgl.glfw.GLFW;
import org.slf4j.Logger;

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;

public final class CameraLockConfigManager {
	private static final Gson GSON = new GsonBuilder().setPrettyPrinting().create();
	private static final Path CONFIG_PATH = FabricLoader.getInstance()
		.getConfigDir()
		.resolve("cameralock.json");

	private static CameraLockConfig config = new CameraLockConfig();

	private CameraLockConfigManager() {
	}

	public static CameraLockConfig get() {
		return config;
	}

	public static void load() {
		if (!Files.exists(CONFIG_PATH)) {
			save();
			return;
		}

		try {
			String json = Files.readString(CONFIG_PATH);
			CameraLockConfig loaded = GSON.fromJson(json, CameraLockConfig.class);
			if (loaded != null) {
				config = loaded;
				clampValues();
			}
		} catch (Exception exception) {
			Logger logger = CameraLockClient.LOGGER;
			logger.error("Failed to load config, using defaults", exception);
			config = new CameraLockConfig();
		}
	}

	public static void save() {
		clampValues();
		try {
			Files.writeString(CONFIG_PATH, GSON.toJson(config));
		} catch (IOException exception) {
			CameraLockClient.LOGGER.error("Failed to save config", exception);
		}
	}

	public static void apply(KeyMapping toggleKey) {
		apply(toggleKey, false);
	}

	public static void apply(KeyMapping toggleKey, boolean saveOptions) {
		clampValues();
		if (toggleKey != null) {
			toggleKey.setKey(InputConstants.Type.KEYSYM.getOrCreate(config.toggleKey));
			if (saveOptions) {
				Minecraft client = Minecraft.getInstance();
				if (client != null && client.options != null) {
					client.options.save();
				}
			}
		}
	}

	public static void replace(CameraLockConfig newConfig, KeyMapping toggleKey) {
		config = newConfig.copy();
		clampValues();
		save();
		apply(toggleKey, true);
		CameraLockKeyHandler.reset();
	}

	private static void clampValues() {
		config.lookSpeed = clamp(config.lookSpeed, 0.5D, 12.0D);
		config.smoothness = clamp(config.smoothness, 0.5D, 12.0D);
		config.lockRadius = clamp(config.lockRadius, 3.0D, 32.0D);
		if (config.toggleKey < 32) {
			config.toggleKey = GLFW.GLFW_KEY_F;
		}
	}

	private static double clamp(double value, double min, double max) {
		return Math.max(min, Math.min(max, value));
	}

	public static String keyName(int keyCode) {
		return CameraLockKeys.nameForCode(keyCode);
	}
}
